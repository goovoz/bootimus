# Bootimus kickstart file — RHEL / Rocky Linux / AlmaLinux / Fedora
# Attach this file to the image in Bootimus; the installer fetches it over HTTP.
# 结构参照 bootimus 官方文档 docs/auto-install 里的 kickstart 示例：
# 口令用 --iscrypted（$6$），公钥用 sshkey 指令而不是在 %post 里手写文件。
#version=RHEL9
text
lang {{.locale}}
keyboard --vckeymap={{.keymap}} --xlayouts='{{.keymap}}'
timezone {{.timezone}} --utc
network --bootproto=dhcp --device=link --activate --hostname={{.hostname}}
{{if .root_hash}}rootpw --iscrypted {{.root_hash}}
{{else}}rootpw --lock
{{end}}user --name={{.username}} --groups=wheel --iscrypted --password={{.user_hash}}
{{if .ssh_key}}sshkey --username={{.username}} "{{.ssh_key}}"
{{end}}services --enabled=sshd
zerombr
clearpart --all --initlabel
{{if eq .partition "lvm"}}autopart --type=lvm
{{else if eq .partition "btrfs"}}autopart --type=btrfs
{{else}}autopart --type=plain
{{end}}
reboot --eject

%packages
@^minimal-environment
{{.packages}}
%end

%post
systemctl enable sshd
%end
