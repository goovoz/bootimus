#cloud-config
# Bootimus autoinstall file — Ubuntu Server 20.04+ (Subiquity)
# Attach this file to the image in Bootimus; the kernel parameter points at it.
autoinstall:
  version: 1
  locale: {{.locale}}
  keyboard:
    layout: {{.keymap}}
  timezone: {{.timezone}}
{{if .mirror_base}}  apt:
    primary:
      - arches: [default]
        uri: {{.mirror_base}}
{{end}}  identity:
    hostname: "{{.hostname}}"
    username: {{.username}}
    password: "{{.hashed_password}}"
  ssh:
    install-server: true
    allow-pw: true
  storage:
    layout:
      name: {{.storage_layout}}
      match:
        size: largest
{{if .package_list}}  packages:
{{range .package_list}}    - {{.}}
{{end}}{{end}}  late-commands:
    - curtin in-target -- systemctl enable ssh
{{if .ssh_key}}    - curtin in-target -- mkdir -p /root/.ssh
    - curtin in-target -- sh -c 'echo "{{.ssh_key}}" > /root/.ssh/authorized_keys'
    - curtin in-target -- chmod 700 /root/.ssh
    - curtin in-target -- chmod 600 /root/.ssh/authorized_keys
{{end}}
