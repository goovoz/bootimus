# Binaries
bootimus
bootimus-*
!/ops/watchdog/bootimus-*
!bootloaders/default/bootimus-arm64.efi
*.exe
*.dll
*.so
*.dylib

# Test binary
*.test

# Output of the go coverage tool
*.out

# Boot directory (may contain large files)
boot/

# Data directory (contains ISOs)
/data/

# Configuration file (may contain secrets)
bootimus.yaml

# Go workspace file
go.work

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

.admin_password
dist/
bootloaders/bootenv/

# Appliance build artefacts — never committed.
appliance/build/
*.img

# Thinos-era blobs occasionally regenerated during development.
bootloaders/thinos-kernel
bootloaders/thinos-initrd

# Cross-compile staging / test output.
/tmp-build/

# Secure Boot signing material — NEVER commit. Private key lives in Vaultwarden.
signing/
*.key
*.crt

# End-to-end QEMU test binary and run logs.
/.e2e/

# UI smoke test binary, dependencies and reports.
/.ui-tests/
ui-tests/node_modules/
ui-tests/test-results/
ui-tests/playwright-report/

# python 脚本跑完留下的
__pycache__/
