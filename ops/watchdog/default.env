# watchdog 可调参数（改完 systemctl restart 不需要，下一轮自动生效）
# 想彻底关掉自动更新：systemctl disable --now bootimus-watchdog.timer

# 装机流量（默认只认 8080 文件服务）上有活跃连接时跳过本轮
SKIP_IF_BUSY=1
# 判断「忙」的端口，逗号分隔。8081 是管理台，长期开着页面不算忙
BUSY_PORTS=8080

# 本地保留多少个镜像（回滚用），默认 3
KEEP_IMAGES=3

# 等容器就绪的最长秒数
HEALTH_TIMEOUT=60

# 健康检查地址。默认留空 = 自动探测：先看 8081 实际监听在哪块网卡，通配则是 loopback。
# 容器用 host 网络并绑到具体网卡时（--bind-interface eth0），127.0.0.1 连不上，
# 自动探测会选中 eth0 的地址；想固定就取消注释并写上真实地址。
# HEALTH_URL=http://192.0.2.10:8081/

# Server酱 SendKey（SCT 开头）。设了才会推送；不设只写日志。
# 只在「更新成功 / 健康检查失败已回滚 / compose up 失败已回滚」时发，没变更不打扰。
# 这个文件里有密钥，装完请 chmod 600 /etc/default/bootimus-watchdog
# SC_SENDKEY=SCTxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
