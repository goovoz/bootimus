[Unit]
Description=bootimus 上游哨兵（上游 main 一变就催 sync-upstream）
Documentation=https://github.com/goovoz/bootimus/blob/main/ops/watchdog/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/bootimus-upstream-watch
ExecStart=/usr/local/sbin/bootimus-watch-upstream
TimeoutStartSec=180
